public function step1()
{
    $session = session();

    if (!$session->get('logged_in')) {
        return redirect()->to(base_url('login'));
    }

    // The payroll cycle page now runs every step; this old step page sends you there.
    $toCycle = $this->redirectToCycle();
    if ($toCycle) {
        return $toCycle;
    }

    $model = new AdminModel();
    $adminEmpId = $session->get('emp_id');

    // Read query flags and month/year
    $month    = (int) ($this->request->getPostGet('month') ?: date('m'));
    $year     = (int) ($this->request->getPostGet('year') ?: date('Y'));
    $isS1     = $this->request->getGet('s1');
    $complete = $this->request->getGet('complete');

    // Validate the selected period
    if ($month < 1 || $month > 12) {
        $month = (int) date('m');
    }
    if ($year < 2000 || $year > 2100) {
        $year = (int) date('Y');
    }

    // Step 1: Check whether attendance is finalized
    $Attendance_generate = $model->get_attendance_finalized($month, $year);
    $Attendance_generate = is_array($Attendance_generate) ? $Attendance_generate : [];

    $attendance_status = $Attendance_generate[0]['attendance_status'] ?? 'N';
    $attendanceStatus  = strtoupper(trim((string) $attendance_status));
    $is_status_true    = in_array($attendanceStatus, ['Y', '1', 'TRUE'], true);

    // ONLY re-trigger create_payroll_cycle() if explicitly returned via the complete flow
    if ($complete && $is_status_true && $session->has('pending_cycle')) {
        return $this->create_payroll_cycle();
    }

    // Step 2: Fetch payroll attendance data only after attendance is finalized
    $records = [];
    $is_finalized = false;

    if ($is_status_true) {
        $records = $model->get_payroll_attendance_data($month, $year, $adminEmpId);
        $records = is_array($records) ? $records : [];

        if (!empty($records)) {
            $recordFinalized = strtoupper(trim((string) ($records[0]['is_finalized'] ?? 'N')));
            $is_finalized = in_array($recordFinalized, ['Y', '1', 'TRUE'], true);
        }
    }

    // Base URL as per your original controller
    $finalizeUrl = base_url('admin/attendance_finalize')
        . '?month=' . urlencode($month)
        . '&year=' . urlencode($year);

    // ONLY append &s1=1 if the user came here through the s1 flow
    if (!empty($isS1)) {
        $finalizeUrl .= '&s1=1';
    }

    $data = [
        'title'                 => 'Payroll Attendance Verification',
        'records'               => $records,
        'selectedMonth'         => $month,
        'selectedYear'          => $year,
        'is_finalized'          => $is_finalized,
        'att_gen'               => $Attendance_generate,
        'attendance_status'     => $attendance_status,
        'attendanceFinalizeUrl' => $finalizeUrl,
    ];

    return view('Layouts/Header')
        . view('Layouts/Sidebar')
        . view('payroll/step1', $data)
        . view('Layouts/Footer');
}

