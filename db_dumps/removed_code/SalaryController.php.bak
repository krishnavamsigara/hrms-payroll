    public function payslips_new($paramEmpId = null, $paramMonth = null, $paramYear = null)
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $sessionId = $session->get('emp_id');

        // Retrieve emp_id from route parameter, GET query, or POST body
        $rawEmpId = $paramEmpId 
            ?? $this->request->getGetPost('emp_id') 
            ?? $this->request->getGetPost('staff_id') 
            ?? $this->request->getGetPost('staff_d');

        // Sanitize emp_id: empty string, whitespace, or 'all' treated as null
        $empid = (!empty($rawEmpId) && trim($rawEmpId) !== '' && strtolower(trim($rawEmpId)) !== 'all') 
            ? trim($rawEmpId) 
            : null;

        $monthInput = $paramMonth ?? $this->request->getGetPost('month') ?? date('n');
        $yearInput  = $paramYear  ?? $this->request->getGetPost('year')  ?? date('Y');

        $month = (int) $monthInput;
        if ($month < 1 || $month > 12) {
            $month = (int) date('n');
        }

        $year = (int) $yearInput;
        if ($year < 2000 || $year > 2100) {
            $year = (int) date('Y');
        }

        $model = new SalaryModel();

        // Case one: when admin wants to see all employees payslip list, $empid is null
        // Case two: when admin wants to see a particular employee payslip, send $empid of that selected row
        if (empty($empid)) {
            $empid = null;
            $payslips = $model->payslips_new($sessionId, null, $month, $year);
            // dd($payslips);
            $isSingle = false;
        } else {
            $payslips = $model->payslips_new($sessionId, $empid, $month, $year);
            $isSingle = true;
        }

        // Normalize array structure if a single associative row was returned
        if (!empty($payslips) && is_array($payslips) && isset($payslips['emp_id'])) {
            $payslips = [$payslips];
        }

        $data = [
            'payslips'      => $payslips ?? [],
            'selectedMonth' => $month,
            'selectedYear'  => $year,
            'month'         => $month,
            'year'          => $year,
            'selectedEmpId' => $empid,
            'isSingle'      => $isSingle,
            'sessionId'     => $sessionId,
        ];

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/payslips_new', $data)
            . view('Layouts/Footer');
    }


