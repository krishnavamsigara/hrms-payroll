    public function step3()
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

    // The payroll cycle page now runs every step; this old step page sends you there.
    $toCycle = $this->redirectToCycle();
    if ($toCycle) {
        return $toCycle;
    }

        $sessionId = $session->get('emp_id');
        $month = (int) ($this->request->getGet('month') ?? date('n'));
        $year = (int) ($this->request->getGet('year') ?? date('Y'));

        if ($month < 1 || $month > 12 || $year < 2000 || $year > 2100) {
            return redirect()->back()->with('error', 'Invalid payroll month or year.');
        }

        $model = new SalaryModel();

        $payrollDetails = $model->get_payroll_month_details(
            $sessionId,
            $month,
            $year
        );

        $data = [
            'payroll_month_details' => $payrollDetails,
            'selectedMonth' => $month,
            'selectedYear' => $year,
            'sessionId' => $sessionId
        ];

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/step3', $data)
            . view('Layouts/Footer');
    }



    public function manage_payroll_status(
        $requester_emp_id = null,
        $payroll_month = null,
        $payroll_year = null,
        $action = null
    ) {
        $session = session();

        if (!$session->get('logged_in')) {
            return $this->response->setJSON([
                'status' => 'N',
                'message' => 'Session expired. Please log in again.'
            ])->setStatusCode(401);
        }

        $request = service('request');

        // Use the authenticated session as the requester identity.
        $requesterEmpId = $session->get('emp_id');

        $pMonth = (int) (
            $payroll_month
            ?? $request->getPost('payroll_month')
            ?? date('n')
        );

        $pYear = (int) (
            $payroll_year
            ?? $request->getPost('payroll_year')
            ?? date('Y')
        );

        $actionType = strtoupper(trim(
            $action ?? $request->getPost('action') ?? ''
        ));

        if ($pMonth < 1 || $pMonth > 12 || $pYear < 2000 || $pYear > 2100) {
            return $this->response->setJSON([
                'status' => 'N',
                'message' => 'Invalid payroll month or year.'
            ])->setStatusCode(400);
        }

        if (!in_array($actionType, ['FINALIZE', 'PAID'], true)) {
            return $this->response->setJSON([
                'status' => 'N',
                'message' => 'Action must be FINALIZE or PAID.'
            ])->setStatusCode(400);
        }

        $model = new SalaryModel();

        $res = $model->manage_payroll_status(
            $requesterEmpId,
            $pMonth,
            $pYear,
            $actionType
        );

        // Handle either a single result row or a result list.
        $resultRow = $res;

        if (is_array($res) && isset($res[0]) && is_array($res[0])) {
            $resultRow = $res[0];
        }

        $status = is_array($resultRow)
            ? strtoupper(trim((string) ($resultRow['status'] ?? 'N')))
            : 'N';

        $remarks = is_array($resultRow)
            ? ($resultRow['remarks'] ?? $resultRow['message'] ?? '')
            : '';

        if ($status !== 'Y') {
            return $this->response->setJSON([
                'status' => 'N',
                'message' => $remarks ?: 'Payroll status update failed.',
                'remarks' => $remarks,
                'action' => $actionType,
                'payroll_month' => $pMonth,
                'payroll_year' => $pYear,
                'csrf_token' => csrf_hash()
            ])->setStatusCode(400);
        }

        return $this->response->setJSON([
            'status' => 'Y',
            'message' => $remarks ?: 'Payroll status updated successfully.',
            'remarks' => $remarks ?: 'Payroll status updated successfully.',
            'action' => $actionType,
            'cycle_status' => $actionType,
            'payroll_month' => $pMonth,
            'payroll_year' => $pYear,
            'csrf_token' => csrf_hash()
        ]);
    }

     
    #step 4

public function step4($paramMonth = null, $paramYear = null)
    {
        $session = session();

        if (!$session->get('logged_in')) {
            if ($this->request->isAJAX()) {
                return $this->response->setJSON([
                    'status' => 'N',
                    'message' => 'Unauthorized or expired session. Please log in again.'
                ])->setStatusCode(401);
            }
            return redirect()->to(base_url('/'));
        }

    // The payroll cycle page now runs every step; this old step page sends you there.
    $toCycle = $this->redirectToCycle();
    if ($toCycle) {
        return $toCycle;
    }

        $sessionId = $session->get('emp_id');

        // Read selected month & year from segment, POST or GET - same as rest of the steps
        $month = $paramMonth
            ?? $this->request->getPost('month')
            ?? $this->request->getGet('month')
            ?? $this->request->getPostGet('month');

        $year = $paramYear
            ?? $this->request->getPost('year')
            ?? $this->request->getGet('year')
            ?? $this->request->getPostGet('year');

        $month = ($month !== null && $month !== '' && is_numeric($month))
            ? (int) $month
            : (int) date('n');

        $year = ($year !== null && $year !== '' && is_numeric($year))
            ? (int) $year
            : (int) date('Y');

        if ($month < 1 || $month > 12) {
            $month = (int) date('n');
        }
        if ($year < 2000 || $year > 2100) {
            $year = (int) date('Y');
        }

        $model = new SalaryModel();

        // Generate/check payslips only on POST
        $payrollDetails = null;
        $status = null;
        $remarks = null;

        if (strtoupper($this->request->getMethod()) === 'POST') {
            try {
                $payrollDetails = $model->generate_payslips(
                    $sessionId,
                    $month,
                    $year
                );
            } catch (\Throwable $e) {
                if ($this->request->isAJAX()) {
                    return $this->response->setJSON([
                        'status' => 'N',
                        'message' => 'Error generating payslips: ' . $e->getMessage(),
                        'remarks' => 'Error generating payslips: ' . $e->getMessage(),
                        'csrf_token' => csrf_hash()
                    ])->setStatusCode(500);
                }
                return redirect()->back()->with('error', 'Error generating payslips: ' . $e->getMessage());
            }

            // Extract status and remarks from procedure result
            $resultRow = $payrollDetails;
            if (is_array($payrollDetails) && isset($payrollDetails[0]) && is_array($payrollDetails[0])) {
                $resultRow = $payrollDetails[0];
            }

            if (is_array($resultRow)) {
                $status = strtoupper(trim((string) ($resultRow['status'] ?? '')));
                $remarks = (string) ($resultRow['remarks'] ?? ($resultRow['message'] ?? ''));
            } elseif (is_bool($payrollDetails)) {
                $status = $payrollDetails ? 'Y' : 'N';
                $remarks = $payrollDetails ? 'Payslips generated successfully.' : 'Procedure returned false.';
            }

            if (empty($status)) {
                $status = 'Y';
            }
            if (empty($remarks)) {
                $remarks = ($status === 'Y')
                    ? 'Payslips generated successfully.'
                    : 'Payslip generation failed.';
            }

            // AJAX response for toaster display
            if ($this->request->isAJAX()) {
                return $this->response->setJSON([
                    'status' => $status,
                    'remarks' => $remarks,
                    'message' => $remarks,
                    'data' => $payrollDetails,
                    'selectedMonth' => $month,
                    'selectedYear' => $year,
                    'csrf_token' => csrf_hash()
                ]);
            }
        }

        $data = [
            'generate_payslip' => $payrollDetails,
            'payslip_status' => $status,
            'payslip_remarks' => $remarks,
            'selectedMonth' => $month,
            'selectedYear' => $year,
            'sessionId' => $sessionId,
        ];

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/step4', $data)
            . view('Layouts/Footer');
    }


public function payroll_summary()
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $sessionId = $session->get('emp_id');
        $month = (int) ($this->request->getGet('month') ?? date('n'));
        $year = (int) ($this->request->getGet('year') ?? date('Y'));

        if ($month < 1 || $month > 12 || $year < 2000 || $year > 2100) {
            return redirect()->back()->with('error', 'Invalid payroll month or year.');
        }

        $model = new SalaryModel();

        $payrollDetails = $model->get_payroll_month_details(
            $sessionId,
            $month,
            $year
        );

        $data = [
            'payroll_month_details' => $payrollDetails,
            'selectedMonth' => $month,
            'selectedYear' => $year,
            'sessionId' => $sessionId
        ];

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/payroll_summary', $data)
            . view('Layouts/Footer');
    }

