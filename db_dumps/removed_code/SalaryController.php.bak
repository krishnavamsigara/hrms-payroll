        public function emp_payslip($empid = '', $month = '', $year = '')
    {
        try {
            $session = session();
            if (!$session->get('logged_in')) {
                return redirect()->to(base_url('/'));
            }

            $model = new SalaryModel();
            $sessionId = $session->get('emp_id');

            // If no values come from URL, use request parameters or current logged-in employee and current month/year
            $empid = !empty($empid) 
                ? $empid 
                : ($this->request->getGetPost('emp_id') 
                    ?? $this->request->getGetPost('staff_id') 
                    ?? $this->request->getGetPost('staff_d') 
                    ?? $session->get('emp_id'));

            $monthRaw = !empty($month) 
                ? $month 
                : ($this->request->getGetPost('month') ?? date('n'));

            $yearRaw = !empty($year) 
                ? $year 
                : ($this->request->getGetPost('year') ?? date('Y'));

            // Parse month to integer 1-12
            if (is_numeric($monthRaw)) {
                $monthNum = (int) $monthRaw;
            } else {
                $parsedTime = strtotime("1 " . trim($monthRaw) . " " . $yearRaw);
                $monthNum = $parsedTime ? (int) date('n', $parsedTime) : (int) date('n');
            }
            if ($monthNum < 1 || $monthNum > 12) {
                $monthNum = (int) date('n');
            }

            // Parse year to integer
            $yearNum = (int) $yearRaw;
            if ($yearNum < 2000 || $yearNum > 2100) {
                $yearNum = (int) date('Y');
            }

            // Call procedure: payslips_new($sessionId, $empid, $month, $year)
            $payslipResult = $model->payslips_new($sessionId, $empid, $monthNum, $yearNum);

            // Normalize single row response if returned directly as associative array
            if (!empty($payslipResult) && is_array($payslipResult) && isset($payslipResult['emp_id'])) {
                $payslipResult = [$payslipResult];
            }

            // Check DB response
            if (!empty($payslipResult) && isset($payslipResult[0]['status']) && strtoupper(trim($payslipResult[0]['status'])) === 'N') {
                $referer = request()->getServer('HTTP_REFERER');
                $errorMsg = $payslipResult[0]['remarks'] ?? 'Unable to retrieve payslip details.';
                if (!empty($referer)) {
                    return redirect()->back()->with('error', $errorMsg);
                }
                return redirect()->to(base_url('payroll/payslips_new'))->with('error', $errorMsg);
            }

            $firstRow = !empty($payslipResult[0]) ? $payslipResult[0] : [];

            // Parse JSON components column
            $componentsRaw = $firstRow['components'] ?? '[]';
            if (is_string($componentsRaw)) {
                $components = json_decode($componentsRaw, true);
                if (!is_array($components)) {
                    $components = [];
                }
            } elseif (is_array($componentsRaw)) {
                $components = $componentsRaw;
            } else {
                $components = [];
            }

            // Dynamically classify components by component_type
            $earnings = [];
            $deductions = [];
            $employerContributions = [];

            foreach ($components as $comp) {
                $ctype = strtoupper(trim((string) ($comp['component_type'] ?? '')));
                if ($ctype === 'EARNING') {
                    $earnings[] = $comp;
                } elseif ($ctype === 'DEDUCTION') {
                    $deductions[] = $comp;
                } elseif ($ctype === 'EMPLOYER_CONTRIBUTION' || $ctype === 'CONTRIBUTION') {
                    $employerContributions[] = $comp;
                }
            }

            $data = [
                'content'                => $payslipResult,
                'payslip'                => $firstRow,
                'components'             => $components,
                'earnings'               => $earnings,
                'deductions'             => $deductions,
                'employer_contributions' => $employerContributions,
                'month'                  => $monthNum,
                'year'                   => $yearNum,
                'selectedEmpId'          => $empid,
            ];

            return view('Layouts/Header')
                . view('Layouts/Sidebar')
                . view('employee/new_emp_payslip', $data)
                . view('Layouts/Footer');
        } catch (\Throwable $e) {
            $referer = request()->getServer('HTTP_REFERER');
            $errorMessage = 'Payslip error: ' . $e->getMessage();
            if (!empty($referer)) {
                return redirect()->back()->with('error', $errorMessage);
            }
            return redirect()->to(base_url('payroll/payslips_new'))->with('error', $errorMessage);
        }
    }

