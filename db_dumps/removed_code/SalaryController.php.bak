 public function pay_roll()
 {
        $session = session();
        if (!$session->get('logged_in')) {
        return redirect()->to(base_url('/'));
        }
        $model = new SalaryModel();
    
        $empid = $session->get('emp_id');

        // filters: month (ALL or a month name) and financial year (April - March), default = current one
        $fyStart = (int) date('n') >= 4 ? (int) date('Y') : (int) date('Y') - 1;
        $month = $this->request->getGet('month') ?: 'ALL';
        $year  = $this->request->getGet('year') ?: ($fyStart . '-' . substr((string) ($fyStart + 1), -2));
        $data['selectedMonth'] = $month;
        $data['selectedYear']  = $year;

        // generated payslips of paid employees from the payroll cycles (employee_payslips)
        $rows = $model->employee_payslip_list($empid, null, $month, $year);
        $data['salary'] = [];
        $data['listMessage'] = '';
        if (isset($rows[0]['status']) && $rows[0]['status'] !== 'Y') {
            $data['listMessage'] = $rows[0]['remarks'] ?? 'No payslips found.';
        } else {
            $data['salary'] = $rows;
        }

        return  view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/payslips',$data)
            . view('Layouts/Footer');
    }

