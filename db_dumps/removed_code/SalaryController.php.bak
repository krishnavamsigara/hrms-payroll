    public function create_payroll_cycle()
{
    $session = session();

    if (!$session->get('logged_in')) {
        return redirect()->to(base_url('/'));
    }

    // New flow: the cycle is created in status OPEN and processed on the payroll cycle page.
    $p = fn($k) => trim((string) ($this->request->getPost($k) ?? ''));
    $row = (new \App\Models\PayrollCycleModel())->cycle_create(
        $session->get('emp_id'), (int) $p('month'), (int) $p('year'), $p('cycle_code'),
        $p('from_date') ?: null, $p('to_date') ?: null, $p('pay_date') ?: null, $p('remarks') ?: null
    )[0] ?? [];
    $session->remove('pending_cycle');
    if (strtoupper((string) ($row['status'] ?? 'N')) === 'Y' && !empty($row['payroll_cycle_id'])) {
        return redirect()->to(base_url('payroll/cycle/' . (int) $row['payroll_cycle_id']))->with('success', $row['remarks']);
    }
    return redirect()->to(base_url('payroll/payroll_dashboard'))
        ->with('error', $row['remarks'] ?? 'Payroll cycle could not be created.');

    /* Old one-step creation (attendance + calculation + approval at once), kept for reference:
    $model = new SalaryModel();
    $sessionId = $session->get('emp_id');

    // Retrieve from POST; fallback to session ONLY if returning via s1/complete flow
    $month     = $this->request->getPost('month')      ?? $session->get('pending_cycle.month');
    $year      = $this->request->getPost('year')       ?? $session->get('pending_cycle.year');
    $fromdate  = $this->request->getPost('from_date')  ?? $session->get('pending_cycle.from_date');
    $todate    = $this->request->getPost('to_date')    ?? $session->get('pending_cycle.to_date');
    $cyclecode = $this->request->getPost('cycle_code') ?? $session->get('pending_cycle.cycle_code');
    $remarks   = $this->request->getPost('remarks')    ?? $session->get('pending_cycle.remarks');
    $paydate   = $this->request->getPost('pay_date')   ?? $session->get('pending_cycle.pay_date');

    // Basic validation
    if (
        empty($month) ||
        empty($year) ||
        empty($fromdate) ||
        empty($todate) ||
        empty($cyclecode)
    ) {
        return redirect()->to(base_url('payroll/payroll_dashboard'))
            ->with('error', 'Please provide all required payroll cycle details.');
    }

    // Optional values
    $paydate = !empty($paydate) ? $paydate : null;
    $remarks = !empty($remarks) ? $remarks : null;

    // Create payroll cycle
    $result = $model->create_payroll_cycle(
        $sessionId,
        $month,
        $year,
        $paydate,
        $fromdate,
        $todate,
        $remarks,
        $cyclecode
    );

    $status  = strtoupper(trim($result['status'] ?? 'N'));
    $message = trim($result['message'] ?? '');

    if ($status === 'Y') {
        // Clear pending session data if present
        $session->remove('pending_cycle');

        return redirect()->to(
            base_url('payroll/step1') .
            '?month=' . urlencode($month) .
            '&year=' . urlencode($year)
        )->with(
            'success',
            !empty($message) ? $message : 'Payroll cycle created successfully.'
        );
    }

    // FAILED / ATTENDANCE NOT FINALIZED:
    // Store in session and attach s1=1 to trigger the special attendance-link flow
    $session->set('pending_cycle', [
        'month'      => $month,
        'year'       => $year,
        'from_date'  => $fromdate,
        'to_date'    => $todate,
        'cycle_code' => $cyclecode,
        'pay_date'   => $paydate,
        'remarks'    => $remarks,
    ]);

    return redirect()->to(
        base_url('payroll/step1') .
        '?month=' . urlencode($month) .
        '&year=' . urlencode($year) .
        '&s1=1'
    )->with(
        'error',
        !empty($message) ? $message : 'Payroll cycle could not be created.'
    );
    */
}

