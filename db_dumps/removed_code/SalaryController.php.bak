    # Get Salary Components 
    public function sal_comp()
   {
        $session = session();
        if (!$session->get('logged_in')) {
        return redirect()->to(base_url('/'));
        }
        $model = new SalaryModel();
        $emp_id = $session->get('emp_id');
        $data['salary_components'] = $model->salary_components($emp_id);
        // dd($data['salary_components']); // Debugging line to check the data
        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/salary_components', $data)
            . view('Layouts/Footer');
   }

   # Manage Salary Components
    public function manage_sal_comp()
    {
        $session = session();
        
        // Check session authorization
        if (!$session->get('logged_in')) {
            if ($this->request->isAJAX()) {
                return $this->response->setJSON([
                    'status'  => false, 
                    'message' => 'Unauthorized or expired session. Please log in again.'
                ])->setStatusCode(401);
            }
            return redirect()->to(base_url('/'));
        }

        $model  = new SalaryModel();
        $emp_id = $session->get('emp_id');

        // Extract input parameters
        $requested_action = strtoupper(trim($this->request->getPost('action') ?? ''));
        $component_id     = $this->request->getPost('component_id');
        $code             = trim($this->request->getPost('code') ?? '');
        $name             = trim($this->request->getPost('name') ?? '');
        $type             = $this->request->getPost('type');
        $calculation_type = $this->request->getPost('calculation_type');
        $percentage_base  = $this->request->getPost('percentage_base');
        $percentage       = $this->request->getPost('percentage');
        $taxable          = $this->request->getPost('taxable');
        $active           = $this->request->getPost('active');

        // Dynamic engine fields (formula, limits, calculation order, eligibility)
        $formula_expression         = trim((string) ($this->request->getPost('formula_expression') ?? ''));
        $minimum_amount             = $this->request->getPost('minimum_amount');
        $maximum_amount             = $this->request->getPost('maximum_amount');
        $calculation_order          = $this->request->getPost('calculation_order');
        $eligibility_parameter      = trim((string) ($this->request->getPost('eligibility_parameter') ?? ''));
        $eligibility_required_value = $eligibility_parameter !== '' ? 'Y' : null;
        $rounding_precision         = $this->request->getPost('rounding_precision');

        // Component kind, manual flag, slabs entered on the same form, and "check only"
        $calculation_scope = strtoupper(trim((string) ($this->request->getPost('calculation_scope') ?? ''))) ?: 'COMPONENT';
        $is_manual = $this->request->getPost('is_manual') ? 1 : 0;
        $is_slab   = $this->request->getPost('is_slab') ? 1 : 0;
        $slab_json = $this->request->getPost('slabs');          // JSON array string, or null when not sent
        if ($slab_json !== null && !$is_slab) {
            $slab_json = '[]';                                   // not a slab component: remove its slabs
        }
        $dry_run = $this->request->getPost('dry_run') ? 1 : 0;

        // Resolve Action branch
        if ($requested_action === 'ACTIVE') {
            $action           = 'ACTIVE';
            $code             = null;
            $name             = null;
            $type             = null;
            $calculation_type = null;
            $percentage_base  = null;
            $percentage       = null;
            $taxable          = null;
            $formula_expression = $minimum_amount = $maximum_amount = $calculation_order = null;
            $eligibility_parameter = $eligibility_required_value = $rounding_precision = null;
            $is_manual = $is_slab = $slab_json = null;
            $dry_run = 0;
        } elseif (!empty($component_id) && $component_id !== 'NULL' && $requested_action === 'UPDATE') {
            $action = 'UPDATE';
        } else {
            $action       = 'INSERT';
            $component_id = null;
        }

        // Execute Model / Stored Procedure with Exception Protection
        try {
            $result = $model->manage_salary_components(
                $emp_id,
                $action,
                $component_id,
                $code,
                $name,
                $type,
                $calculation_type,
                $percentage_base,
                $percentage,
                $taxable,
                $active,
                $formula_expression,
                $minimum_amount,
                $maximum_amount,
                $calculation_scope,
                $calculation_order,
                $eligibility_parameter,
                $eligibility_required_value,
                $is_slab,
                $rounding_precision,
                $is_manual,
                $slab_json,
                $dry_run
            );
        } catch (\Throwable $e) {
            log_message('error', 'manage_sal_comp exception: ' . $e->getMessage());

            if ($this->request->isAJAX()) {
                return $this->response->setJSON([
                    'status'  => false,
                    'message' => 'Database error: ' . $e->getMessage()
                ])->setStatusCode(500);
            }

            return redirect()->to(base_url('payroll/salary_components'))->with('error', $e->getMessage());
        }

        // The procedure always answers with one row: status (Y/N) and remarks.
        $row = $this->firstProcedureRow($result);
        $ok  = strtoupper(trim((string) ($row['status'] ?? 'N'))) === 'Y';

        $actionMessages = [
            'INSERT' => 'Salary component added successfully.',
            'UPDATE' => 'Salary component updated successfully.',
            'ACTIVE' => 'Component status updated successfully.'
        ];
        $msg = trim((string) ($row['remarks'] ?? ''));
        if ($msg === '') {
            $msg = $ok
                ? ($actionMessages[$action] ?? 'Operation completed successfully.')
                : "Failed to execute {$action} on salary component.";
        }

        if ($this->request->isAJAX()) {
            return $this->response->setJSON([
                'status'       => $ok,
                'action'       => $action,
                'dry_run'      => (bool) $dry_run,
                'message'      => $msg,
                'component_id' => $row['component_id'] ?? null,
                'csrf_token'   => csrf_hash() // Send refreshed CSRF token if regeneration is on
            ]);
        }

        return redirect()->to(base_url('payroll/salary_components'))->with($ok ? 'success' : 'error', $msg);
    }

    /**
     * First row of a procedure result, whether the model returned a list of rows or one row.
     */
    private function firstProcedureRow($result): array
    {
        if (is_array($result) && isset($result[0]) && is_array($result[0])) {
            return $result[0];
        }
        return (is_array($result) && isset($result['status'])) ? $result : [];
    }

    # Components page: "Check formula" button
    public function validate_formula()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }

        $model = new SalaryModel();
        $row = $this->firstProcedureRow($model->validate_component_formula(
            $session->get('emp_id'),
            $this->request->getPost('component_id'),
            strtoupper(trim((string) ($this->request->getPost('code') ?? ''))),
            $this->request->getPost('calculation_order'),
            trim((string) ($this->request->getPost('formula_expression') ?? ''))
        ));

        return $this->response->setJSON([
            'status'        => strtoupper(trim((string) ($row['status'] ?? 'N'))) === 'Y',
            'message'       => $row['remarks'] ?? 'Formula could not be checked.',
            'sample_result' => $row['sample_result'] ?? null,
            'csrf_token'    => csrf_hash(),
        ]);
    }

    # Components page: slabs of one component
    public function component_slabs()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }

        $componentId = (int) $this->request->getGet('component_id');
        $model = new SalaryModel();
        $rows  = $model->component_slabs($session->get('emp_id'), $componentId);
        $first = $this->firstProcedureRow($rows);
        $ok    = strtoupper(trim((string) ($first['status'] ?? 'N'))) === 'Y';

        $slabs = [];
        if ($ok) {
            foreach ($rows as $r) {
                if (!empty($r['slab_id'])) {
                    unset($r['status'], $r['remarks']);
                    $slabs[] = $r;
                }
            }
        }

        return $this->response->setJSON([
            'status'  => $ok,
            'message' => $first['remarks'] ?? '',
            'slabs'   => $slabs,
        ]);
    }

    # Components page: save all slabs of one component
    public function save_component_slabs()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }

        $componentId = (int) $this->request->getPost('component_id');
        $slabJson    = (string) ($this->request->getPost('slabs') ?? '');
        $decoded     = json_decode($slabJson, true);

        if ($componentId <= 0 || !is_array($decoded)) {
            return $this->response->setJSON([
                'status'     => false,
                'message'    => 'Component and slab list are required.',
                'csrf_token' => csrf_hash(),
            ]);
        }

        $model = new SalaryModel();
        $row = $this->firstProcedureRow($model->save_component_slabs(
            $session->get('emp_id'),
            $componentId,
            json_encode(array_values($decoded))
        ));

        return $this->response->setJSON([
            'status'     => strtoupper(trim((string) ($row['status'] ?? 'N'))) === 'Y',
            'message'    => $row['remarks'] ?? 'Slabs could not be saved.',
            'slab_count' => $row['slab_count'] ?? 0,
            'csrf_token' => csrf_hash(),
        ]);
    }


    public function sal_struct()
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $model = new SalaryModel();
        $sessionId = $session->get('emp_id');

        $data['salary_structure'] = $model->salary_structure($sessionId, null);
        $data['without_salary'] = $model->employees_without_salary($sessionId);   // new joiners
        $data['esi_review'] = $model->esi_review($sessionId);                     // ESI off but gross within the limit
        $data['esi_limit'] = $model->esi_wage_limit();

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/salary_structure', $data)
            . view('Layouts/Footer');
    }

    public function update_salary_component()
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $id                 = $session->get('emp_id');
        $employee_id        = $this->request->getPost('employee_id');
        $component_id       = $this->request->getPost('component_id');
        $calculation_type   = $this->request->getPost('calculation_type');
        $component_value    = $this->request->getPost('component_value');
        $percentage_base    = $this->request->getPost('percentage_base');
        $formula_expression = $this->request->getPost('formula_expression');

        $model = new SalaryModel();

        $success = $model->edit_salary_structure(
            $id,
            $employee_id,
            $component_id,
            $calculation_type,
            $component_value,
            $percentage_base,
            $formula_expression
        );

        // The procedure answers with status (Y/N) and remarks; the salary is recalculated by the engine.
        $row = (is_array($success) && isset($success[0])) ? $success[0] : [];
        $ok  = strtoupper((string) ($row['status'] ?? 'N')) === 'Y';
        return redirect()->to(site_url('payroll/salary_structure'))
            ->with($ok ? 'success' : 'error', $row['remarks'] ?? ($ok ? 'Salary component updated successfully.' : 'Unable to update salary component.'));
    }

    # Salary structure page: live preview from the salary engine (nothing is saved)
    public function preview_salary_structure()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }

        $ctc     = $this->request->getPost('monthly_ctc');
        $changes = json_decode((string) ($this->request->getPost('changes') ?? '[]'), true);
        $changes = is_array($changes) ? array_values($changes) : [];

        $structureId = (int) $this->request->getPost('structure_id');
        $rows = (new SalaryModel())->preview_salary_structure(
            $session->get('emp_id'),
            strtoupper(trim((string) $this->request->getPost('emp_id'))),
            ($ctc === null || $ctc === '') ? null : (float) $ctc,
            json_encode($changes),
            $structureId > 0 ? $structureId : null
        );
        return $this->previewJson($rows);
    }

    /**
     * Where the employee salary page goes back to: the payroll cycle it was opened
     * from (return=cycle/{id}) or the salary structure list. Only these two.
     */
    private function salaryReturnUrl(?string $return): string
    {
        $return = trim((string) $return);
        if (preg_match('#^cycle/(\d+)$#', $return, $m)) {
            return base_url('payroll/cycle/' . (int) $m[1]);
        }
        return base_url('payroll/salary_structure');
    }

    /** Preview rows (C-074 / C-083 shape) as JSON: amounts and totals by component code. */
    private function previewJson(array $rows)
    {
        $first = $rows[0] ?? [];
        $ok = strtoupper((string) ($first['status'] ?? 'N')) === 'Y';
        $amounts = [];
        $types = [];
        $totals = [];
        if ($ok) {
            foreach ($rows as $r) {
                $code = strtoupper((string) ($r['component_code'] ?? ''));
                if ($code === '') {
                    continue;
                }
                if (strtoupper((string) $r['calculation_scope']) === 'AGGREGATE') {
                    $totals[$code] = (float) $r['monthly_amount'];
                } else {
                    $amounts[$code] = (float) $r['monthly_amount'];
                    $types[$code] = $r['component_type'];
                }
            }
        }
        return $this->response->setJSON([
            'status'     => $ok,
            'message'    => $first['remarks'] ?? 'Preview failed.',
            'amounts'    => $amounts,
            'types'      => $types,
            'totals'     => $totals,
            'csrf_token' => csrf_hash(),
        ]);
    }

    # GET payroll/salary_structure/new/{emp_id}?from=YYYY-MM-DD&return=cycle/{id} : add a salary
    public function new_salary($empId = null)
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $empId  = strtoupper(trim((string) $empId));
        $return = (string) ($this->request->getGet('return') ?? '');
        $model  = new SalaryModel();
        $me     = $session->get('emp_id');

        $periods = $model->salary_periods($me, $empId);
        $first   = $periods[0] ?? [];
        if (strtoupper((string) ($first['status'] ?? 'N')) !== 'Y') {
            return redirect()->to($this->salaryReturnUrl($return))->with('error', $first['remarks'] ?? 'Employee not found.');
        }
        if (strtolower((string) ($first['login_status'] ?? '')) !== 'active') {
            return redirect()->to($this->salaryReturnUrl($return))
                ->with('error', 'Employee ' . $empId . ' is not active, so a salary cannot be added.');
        }

        // default "applies from": the joining date, or the start of the payroll period it was opened from if that is later
        $fromParam = (string) ($this->request->getGet('from') ?? '');
        $fromParam = preg_match('/^\d{4}-\d{2}-\d{2}$/', $fromParam) ? $fromParam : '';
        $joining   = (string) ($first['joining_date'] ?? '');
        $candidates = array_filter([$fromParam, $joining]);
        $defaultFrom = $candidates ? max($candidates) : date('Y-m-d');

        $rules = [];
        foreach ($model->salary_period_components($me, null) as $c) {
            if (!empty($c['component_id'])) {
                $rules[] = $c;
            }
        }

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/salary_structure_new', [
                'esiLimit'    => $model->esi_wage_limit(),   // from the ESI slabs
                'employee'    => $first,
                'periods'     => array_values(array_filter($periods, fn($p) => !empty($p['structure_id']))),
                'components'  => $rules,
                'defaultFrom' => $defaultFrom,
                'returnParam' => preg_match('#^cycle/\d+$#', $return) ? $return : '',
                'returnUrl'   => $this->salaryReturnUrl($return),
            ])
            . view('Layouts/Footer');
    }

    # POST payroll/salary_structure/new_preview : amounts of the new salary (nothing saved)
    public function preview_new_salary()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }
        $ctc = $this->request->getPost('monthly_ctc');
        return $this->previewJson((new SalaryModel())->preview_new_salary(
            $session->get('emp_id'),
            strtoupper(trim((string) $this->request->getPost('emp_id'))),
            ($ctc === null || $ctc === '') ? null : (float) $ctc,
            strtoupper(trim((string) $this->request->getPost('esi'))) === 'Y' ? 'Y' : 'N'
        ));
    }

    # POST payroll/salary_structure/create : create the salary with every active component
    public function create_employee_salary()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }
        $empId  = strtoupper(trim((string) $this->request->getPost('emp_id')));
        $ctc    = $this->request->getPost('monthly_ctc');
        $from   = trim((string) ($this->request->getPost('effective_from') ?? ''));
        $esi    = strtoupper(trim((string) ($this->request->getPost('esi') ?? '')));
        $return = (string) ($this->request->getPost('return') ?? '');

        $row = (new SalaryModel())->create_employee_salary(
            $session->get('emp_id'),
            $empId,
            ($ctc === null || $ctc === '') ? null : (float) $ctc,
            $from !== '' ? $from : null,
            $esi
        )[0] ?? [];
        $ok = strtoupper((string) ($row['status'] ?? 'N')) === 'Y';
        if ($ok) {
            $session->setFlashdata('success', $empId . ': ' . ($row['remarks'] ?? 'Salary created.'));
        }

        return $this->response->setJSON([
            'status'       => $ok,
            'message'      => $row['remarks'] ?? 'The salary could not be created.',
            'structure_id' => $row['structure_id'] ?? null,
            'redirect'     => $ok ? $this->salaryReturnUrl($return) : null,
            'csrf_token'   => csrf_hash(),
        ]);
    }

    # GET payroll/salary_structure/edit/{emp_id}?period={structure_id}&return=cycle/{id}
    public function edit_salary_structure($empId = null)
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $empId  = strtoupper(trim((string) $empId));
        $return = (string) ($this->request->getGet('return') ?? '');
        $model  = new SalaryModel();
        $me     = $session->get('emp_id');

        $periods = $model->salary_periods($me, $empId);
        $first   = $periods[0] ?? [];
        if (strtoupper((string) ($first['status'] ?? 'N')) !== 'Y') {
            return redirect()->to($this->salaryReturnUrl($return))
                ->with('error', $first['remarks'] ?? 'Employee not found.');
        }

        // the period to edit: ?period=, else the salary in force today, else the newest
        $periods = array_values(array_filter($periods, fn($p) => !empty($p['structure_id'])));
        $wanted  = (int) ($this->request->getGet('period') ?? 0);
        $current = null;
        foreach ($periods as $p) {
            if ($wanted > 0 && (int) $p['structure_id'] === $wanted) {
                $current = $p;
                break;
            }
        }
        if ($current === null) {
            foreach ($periods as $p) {
                if ((int) $p['is_current'] === 1) {
                    $current = $p;
                    break;
                }
            }
        }
        if ($current === null && !empty($periods)) {
            $current = $periods[0];
        }

        $components = [];
        if ($current !== null) {
            foreach ($model->salary_period_components($me, (int) $current['structure_id']) as $c) {
                if (!empty($c['component_id'])) {
                    $components[] = $c;
                }
            }
        }

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/salary_structure_edit', [
                'employee'   => $first,
                'periods'    => $periods,
                'current'    => $current,
                'components' => $components,
                'returnParam' => preg_match('#^cycle/\d+$#', $return) ? $return : '',
                'returnUrl'  => $this->salaryReturnUrl($return),
            ])
            . view('Layouts/Footer');
    }

    # POST payroll/salary_structure/save : CTC, applies-from date and all changed components in one step
    public function save_employee_salary()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }

        $empId   = strtoupper(trim((string) $this->request->getPost('emp_id')));
        $changes = json_decode((string) ($this->request->getPost('changes') ?? '[]'), true);
        $changes = is_array($changes) ? array_values($changes) : [];
        $ctc     = $this->request->getPost('monthly_ctc');
        $from    = trim((string) ($this->request->getPost('effective_from') ?? ''));
        $return  = (string) ($this->request->getPost('return') ?? '');

        $rows = (new SalaryModel())->save_employee_salary(
            $session->get('emp_id'),
            $empId,
            (int) $this->request->getPost('structure_id'),
            ($ctc === null || $ctc === '') ? null : (float) $ctc,
            $from !== '' ? $from : null,
            json_encode($changes)
        );
        $row = $rows[0] ?? [];
        $ok  = strtoupper((string) ($row['status'] ?? 'N')) === 'Y';

        if ($ok) {
            $session->setFlashdata('success', $row['remarks'] ?? 'Salary saved.');
        }
        // back to the payroll cycle it came from; otherwise stay on this employee's (new) salary period
        $next = preg_match('#^cycle/\d+$#', $return)
            ? $this->salaryReturnUrl($return)
            : base_url('payroll/salary_structure/edit/' . rawurlencode($empId) . '?period=' . (int) ($row['structure_id'] ?? 0));

        return $this->response->setJSON([
            'status'       => $ok,
            'message'      => $row['remarks'] ?? 'The salary could not be saved.',
            'structure_id' => $row['structure_id'] ?? null,
            'new_period'   => (int) ($row['new_period'] ?? 0),
            'redirect'     => $ok ? $next : null,
            'csrf_token'   => csrf_hash(),
        ]);
    }

    public function update_monthly_ctc()
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $model = new SalaryModel();

        $sessionId = $session->get('emp_id');
        $empId = $this->request->getPost('emp_id');
        $salary = (float) $this->request->getPost('monthly_ctc');
        $effectiveDate = $this->request->getPost('effective_from') ?: date('Y-m-d');

        $success = $model->update_salary_structure(
            $sessionId,
            $empId,
            $salary,
            $effectiveDate
        );

        $row = (is_array($success) && isset($success[0])) ? $success[0] : [];
        $ok  = strtoupper((string) ($row['status'] ?? 'N')) === 'Y';
        return redirect()->to(site_url('payroll/salary_structure'))
            ->with($ok ? 'success' : 'error', $row['remarks'] ?? ($ok ? 'Monthly CTC updated successfully.' : 'Unable to update Monthly CTC.'));
    }

    /**
     * The old step pages (step1-step4) send the user to the payroll cycle page of the
     * selected month; without a cycle for that month, to the payroll dashboard.
     */
    private function redirectToCycle()
    {
        $month = (int) ($this->request->getGetPost('month') ?: date('n'));
        $year  = (int) ($this->request->getGetPost('year') ?: date('Y'));
        $id = \App\Controllers\PayrollCycleController::cycleIdFor($month, $year);
        $target = $id ? base_url('payroll/cycle/' . $id) : base_url('payroll/payroll_dashboard');
        if ($this->request->isAJAX()) {
            return $this->response->setJSON([
                'status'   => 'N',
                'message'  => 'Payroll steps now run on the payroll cycle page.',
                'remarks'  => 'Payroll steps now run on the payroll cycle page.',
                'redirect' => $target,
            ]);
        }
        return $id
            ? redirect()->to($target)
            : redirect()->to($target)->with('error', 'No payroll cycle exists for that month yet. Create one first.');
    }



