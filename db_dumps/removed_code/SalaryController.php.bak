    #step 2

public function step2()
{
    $session = session();

    // Check login session.
    if (!$session->get('logged_in')) {
        return redirect()->to(base_url('/'));
    }

    // The payroll cycle page now runs every step; this old step page sends you there.
    $toCycle = $this->redirectToCycle();
    if ($toCycle) {
        return $toCycle;
    }

    $model = new SalaryModel();
    $sessionId = $session->get('emp_id');

    // Read selected payroll month and year from the URL.
    $month = $this->request->getGet('month');
    $year  = $this->request->getGet('year');

    $month = ($month !== null && ctype_digit((string) $month))
        ? (int) $month
        : (int) date('m');

    $year = ($year !== null && ctype_digit((string) $year))
        ? (int) $year
        : (int) date('Y');

    // Validate selected period.
    if ($month < 1 || $month > 12) {
        $month = (int) date('m');
    }

    if ($year < 2000 || $year > 2100) {
        $year = (int) date('Y');
    }

    // Load existing salary structure data.
    $data['salary_structure'] = $model->salary_structure($sessionId, null);

    // Send selected period to the view.
    $data['selectedMonth'] = $month;
    $data['selectedYear']  = $year;

    return view('Layouts/Header')
        . view('Layouts/Sidebar')
        . view('payroll/step2', $data)
        . view('Layouts/Footer');
}



