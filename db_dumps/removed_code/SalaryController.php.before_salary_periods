    # GET payroll/salary_structure/edit/{emp_id}?period={structure_id}&return=cycle/{id}
    public function edit_salary_structure($empId = null)
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $empId  = strtoupper(trim((string) $empId));
        $return = (string) ($this->request->getGet('return') ?? '');
        $model  = new SalaryModel();
        $me     = $session->get('emp_id');

        $periods = $model->salary_periods($me, $empId);
        $first   = $periods[0] ?? [];
        if (strtoupper((string) ($first['status'] ?? 'N')) !== 'Y') {
            return redirect()->to($this->salaryReturnUrl($return))
                ->with('error', $first['remarks'] ?? 'Employee not found.');
        }

        // the period to edit: ?period=, else the salary in force today, else the newest
        $periods = array_values(array_filter($periods, fn($p) => !empty($p['structure_id'])));
        $wanted  = (int) ($this->request->getGet('period') ?? 0);
        $current = null;
        foreach ($periods as $p) {
            if ($wanted > 0 && (int) $p['structure_id'] === $wanted) {
                $current = $p;
                break;
            }
        }
        if ($current === null) {
            foreach ($periods as $p) {
                if ((int) $p['is_current'] === 1) {
                    $current = $p;
                    break;
                }
            }
        }
        if ($current === null && !empty($periods)) {
            $current = $periods[0];
        }

        $components = [];
        if ($current !== null) {
            foreach ($model->salary_period_components($me, (int) $current['structure_id']) as $c) {
                if (!empty($c['component_id'])) {
                    $components[] = $c;
                }
            }
        }

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/salary_structure_edit', [
                'employee'   => $first,
                'periods'    => $periods,
                'current'    => $current,
                'components' => $components,
                'returnParam' => preg_match('#^cycle/\d+$#', $return) ? $return : '',
                'returnUrl'  => $this->salaryReturnUrl($return),
            ])
            . view('Layouts/Footer');
    }

    # POST payroll/salary_structure/save : CTC, applies-from date and all changed components in one step
    public function save_employee_salary()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return $this->response->setJSON(['status' => false, 'message' => 'Session expired. Please log in again.'])->setStatusCode(401);
        }

        $empId   = strtoupper(trim((string) $this->request->getPost('emp_id')));
        $changes = json_decode((string) ($this->request->getPost('changes') ?? '[]'), true);
        $changes = is_array($changes) ? array_values($changes) : [];
        $ctc     = $this->request->getPost('monthly_ctc');
        $from    = trim((string) ($this->request->getPost('effective_from') ?? ''));
        $return  = (string) ($this->request->getPost('return') ?? '');

        $rows = (new SalaryModel())->save_employee_salary(
            $session->get('emp_id'),
            $empId,
            (int) $this->request->getPost('structure_id'),
            ($ctc === null || $ctc === '') ? null : (float) $ctc,
            $from !== '' ? $from : null,
            json_encode($changes)
        );
        $row = $rows[0] ?? [];
        $ok  = strtoupper((string) ($row['status'] ?? 'N')) === 'Y';

        if ($ok) {
            $session->setFlashdata('success', $row['remarks'] ?? 'Salary saved.');
        }
        // back to the payroll cycle it came from; otherwise stay on this employee's (new) salary period
        $next = preg_match('#^cycle/\d+$#', $return)
            ? $this->salaryReturnUrl($return)
            : base_url('payroll/salary_structure/edit/' . rawurlencode($empId) . '?period=' . (int) ($row['structure_id'] ?? 0));

        return $this->response->setJSON([
            'status'       => $ok,
            'message'      => $row['remarks'] ?? 'The salary could not be saved.',
            'structure_id' => $row['structure_id'] ?? null,
            'new_period'   => (int) ($row['new_period'] ?? 0),
            'redirect'     => $ok ? $next : null,
            'csrf_token'   => csrf_hash(),
        ]);
    }

