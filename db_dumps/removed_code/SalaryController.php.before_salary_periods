   # Manage Salary Components
    public function manage_sal_comp()
    {
        $session = session();
        
        // Check session authorization
        if (!$session->get('logged_in')) {
            if ($this->request->isAJAX()) {
                return $this->response->setJSON([
                    'status'  => false, 
                    'message' => 'Unauthorized or expired session. Please log in again.'
                ])->setStatusCode(401);
            }
            return redirect()->to(base_url('/'));
        }

        $model  = new SalaryModel();
        $emp_id = $session->get('emp_id');

        // Extract input parameters
        $requested_action = strtoupper(trim($this->request->getPost('action') ?? ''));
        $component_id     = $this->request->getPost('component_id');
        $code             = trim($this->request->getPost('code') ?? '');
        $name             = trim($this->request->getPost('name') ?? '');
        $type             = $this->request->getPost('type');
        $calculation_type = $this->request->getPost('calculation_type');
        $percentage_base  = $this->request->getPost('percentage_base');
        $percentage       = $this->request->getPost('percentage');
        $taxable          = $this->request->getPost('taxable');
        $active           = $this->request->getPost('active');

        // Dynamic engine fields (formula, limits, calculation order, eligibility)
        $formula_expression         = trim((string) ($this->request->getPost('formula_expression') ?? ''));
        $minimum_amount             = $this->request->getPost('minimum_amount');
        $maximum_amount             = $this->request->getPost('maximum_amount');
        $calculation_order          = $this->request->getPost('calculation_order');
        $eligibility_parameter      = trim((string) ($this->request->getPost('eligibility_parameter') ?? ''));
        $eligibility_required_value = $eligibility_parameter !== '' ? 'Y' : null;
        $rounding_precision         = $this->request->getPost('rounding_precision');

        // Component kind, manual flag, slabs entered on the same form, and "check only"
        $calculation_scope = strtoupper(trim((string) ($this->request->getPost('calculation_scope') ?? ''))) ?: 'COMPONENT';
        $is_manual = $this->request->getPost('is_manual') ? 1 : 0;
        $is_slab   = $this->request->getPost('is_slab') ? 1 : 0;
        $slab_json = $this->request->getPost('slabs');          // JSON array string, or null when not sent
        if ($slab_json !== null && !$is_slab) {
            $slab_json = '[]';                                   // not a slab component: remove its slabs
        }
        $dry_run = $this->request->getPost('dry_run') ? 1 : 0;
        // put the component into the total of its type (GROSS / TOTAL_DEDUCTIONS / TOTAL_EMPLOYER_CONTRIBUTION)
        $add_to_total = $this->request->getPost('add_to_total') ? 1 : 0;

        // Resolve Action branch
        if ($requested_action === 'ACTIVE') {
            $action           = 'ACTIVE';
            $code             = null;
            $name             = null;
            $type             = null;
            $calculation_type = null;
            $percentage_base  = null;
            $percentage       = null;
            $taxable          = null;
            $formula_expression = $minimum_amount = $maximum_amount = $calculation_order = null;
            $eligibility_parameter = $eligibility_required_value = $rounding_precision = null;
            $is_manual = $is_slab = $slab_json = null;
            $dry_run = 0;
            $add_to_total = 0;
        } elseif (!empty($component_id) && $component_id !== 'NULL' && $requested_action === 'UPDATE') {
            $action = 'UPDATE';
        } else {
            $action       = 'INSERT';
            $component_id = null;
        }

        // Execute Model / Stored Procedure with Exception Protection
        try {
            $result = $model->manage_salary_components(
                $emp_id,
                $action,
                $component_id,
                $code,
                $name,
                $type,
                $calculation_type,
                $percentage_base,
                $percentage,
                $taxable,
                $active,
                $formula_expression,
                $minimum_amount,
                $maximum_amount,
                $calculation_scope,
                $calculation_order,
                $eligibility_parameter,
                $eligibility_required_value,
                $is_slab,
                $rounding_precision,
                $is_manual,
                $slab_json,
                $dry_run,
                $add_to_total
            );
        } catch (\Throwable $e) {
            log_message('error', 'manage_sal_comp exception: ' . $e->getMessage());

            if ($this->request->isAJAX()) {
                return $this->response->setJSON([
                    'status'  => false,
                    'message' => 'Database error: ' . $e->getMessage()
                ])->setStatusCode(500);
            }

            return redirect()->to(base_url('payroll/salary_components'))->with('error', $e->getMessage());
        }

        // The procedure always answers with one row: status (Y/N) and remarks.
        $row = $this->firstProcedureRow($result);
        $ok  = strtoupper(trim((string) ($row['status'] ?? 'N'))) === 'Y';

        $actionMessages = [
            'INSERT' => 'Salary component added successfully.',
            'UPDATE' => 'Salary component updated successfully.',
            'ACTIVE' => 'Component status updated successfully.'
        ];
        $msg = trim((string) ($row['remarks'] ?? ''));
        if ($msg === '') {
            $msg = $ok
                ? ($actionMessages[$action] ?? 'Operation completed successfully.')
                : "Failed to execute {$action} on salary component.";
        }

        if ($this->request->isAJAX()) {
            return $this->response->setJSON([
                'status'       => $ok,
                'action'       => $action,
                'dry_run'      => (bool) $dry_run,
                'message'      => $msg,
                'component_id' => $row['component_id'] ?? null,
                // rule checker results and the before / after of every changed salary
                'findings'     => json_decode((string) ($row['findings'] ?? ''), true) ?: [],
                'impact'       => json_decode((string) ($row['impact'] ?? ''), true),
                'csrf_token'   => csrf_hash() // Send refreshed CSRF token if regeneration is on
            ]);
        }

        return redirect()->to(base_url('payroll/salary_components'))->with($ok ? 'success' : 'error', $msg);
    }

    /**
     * First row of a procedure result, whether the model returned a list of rows or one row.
     */
    private function firstProcedureRow($result): array
    {
        if (is_array($result) && isset($result[0]) && is_array($result[0])) {
            return $result[0];
        }
        return (is_array($result) && isset($result['status'])) ? $result : [];
    }

