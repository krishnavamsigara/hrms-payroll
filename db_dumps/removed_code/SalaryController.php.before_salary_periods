    public function payroll_dash()
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }
        
        $model = new SalaryModel();
        $sessionId = $session->get('emp_id');
        $year = $this->request->getPost('year');
        if (empty($year) || !is_numeric($year)) {
            $year = date('Y');
        }
        $year = (int) $year;
        if ($year < 2020 || $year > ((int) date('Y') + 1)) {
            $year = (int) date('Y');
        }
        // Cycles of the year from the payroll cycle engine (includes cycles that have no run yet)
        $cycles = [];
        foreach ((new \App\Models\PayrollCycleModel())->cycle_list($sessionId, $year) as $row) {
            if (!empty($row['payroll_cycle_id'])) {
                $cycles[] = $row;
            }
        }
        $data = [
            'selectedYear'  => $year,
            'payroll_cycles' => $cycles,
            // the cycle still in progress (any year): the dashboard continues it instead of creating a new one
            'activeCycle'   => (new \App\Models\PayrollCycleModel())->active_cycle($sessionId),
        ];
        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/payroll_dashboard', $data)
            . view('Layouts/Footer');
    }

    public function create_payroll_cycle()
{
    $session = session();

    if (!$session->get('logged_in')) {
        return redirect()->to(base_url('/'));
    }

    // New flow: the cycle is created in status OPEN and processed on the payroll cycle page.
    $p = fn($k) => trim((string) ($this->request->getPost($k) ?? ''));
    $row = (new \App\Models\PayrollCycleModel())->cycle_create(
        $session->get('emp_id'), (int) $p('month'), (int) $p('year'), $p('cycle_code'),
        $p('from_date') ?: null, $p('to_date') ?: null, $p('pay_date') ?: null, $p('remarks') ?: null
    )[0] ?? [];
    $session->remove('pending_cycle');
    if (strtoupper((string) ($row['status'] ?? 'N')) === 'Y' && !empty($row['payroll_cycle_id'])) {
        return redirect()->to(base_url('payroll/cycle/' . (int) $row['payroll_cycle_id']))->with('success', $row['remarks']);
    }
    return redirect()->to(base_url('payroll/payroll_dashboard'))
        ->with('error', $row['remarks'] ?? 'Payroll cycle could not be created.');
}

