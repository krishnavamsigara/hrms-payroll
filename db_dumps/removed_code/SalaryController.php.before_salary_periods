    public function payslips_new($paramEmpId = null, $paramMonth = null, $paramYear = null)
    {
        $session = session();

        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $sessionId = $session->get('emp_id');

        // Retrieve emp_id from route parameter, GET query, or POST body
        $rawEmpId = $paramEmpId 
            ?? $this->request->getGetPost('emp_id') 
            ?? $this->request->getGetPost('staff_id') 
            ?? $this->request->getGetPost('staff_d');

        // Sanitize emp_id: empty string, whitespace, or 'all' treated as null
        $empid = (!empty($rawEmpId) && trim($rawEmpId) !== '' && strtolower(trim($rawEmpId)) !== 'all') 
            ? trim($rawEmpId) 
            : null;

        $monthInput = $paramMonth ?? $this->request->getGetPost('month') ?? date('n');
        $yearInput  = $paramYear  ?? $this->request->getGetPost('year')  ?? date('Y');

        $month = (int) $monthInput;
        if ($month < 1 || $month > 12) {
            $month = (int) date('n');
        }

        $year = (int) $yearInput;
        if ($year < 2000 || $year > 2100) {
            $year = (int) date('Y');
        }

        $model = new SalaryModel();

        // Case one: when admin wants to see all employees payslip list, $empid is null
        // Case two: when admin wants to see a particular employee payslip, send $empid of that selected row
        if (empty($empid)) {
            $empid = null;
            $payslips = $model->payslips_new($sessionId, null, $month, $year);
            // dd($payslips);
            $isSingle = false;
        } else {
            $payslips = $model->payslips_new($sessionId, $empid, $month, $year);
            $isSingle = true;
        }

        // Normalize array structure if a single associative row was returned
        if (!empty($payslips) && is_array($payslips) && isset($payslips['emp_id'])) {
            $payslips = [$payslips];
        }

        $data = [
            'payslips'      => $payslips ?? [],
            'selectedMonth' => $month,
            'selectedYear'  => $year,
            'month'         => $month,
            'year'          => $year,
            'selectedEmpId' => $empid,
            'isSingle'      => $isSingle,
            'sessionId'     => $sessionId,
        ];

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/payslips_new', $data)
            . view('Layouts/Footer');
    }

    # GET payroll/audit_log : who changed what in payroll, with before / after (C-130).
    # Active ADMIN or HR only - checked inside hrms_payroll_audit_list.
    public function audit_log()
    {
        $session = session();
        if (!$session->get('logged_in')) {
            return redirect()->to(base_url('/'));
        }

        $modules = ['CYCLE', 'COMPONENT', 'SLAB', 'SALARY', 'MANUAL_INPUT', 'ATTENDANCE', 'PAYSLIP', 'SECURITY'];
        $module  = strtoupper(trim((string) $this->request->getGet('module')));
        $module  = in_array($module, $modules, true) ? $module : '';
        $emp     = trim((string) $this->request->getGet('emp'));
        $from    = trim((string) $this->request->getGet('from'));
        $to      = trim((string) $this->request->getGet('to'));
        $search  = trim((string) $this->request->getGet('q'));
        $isDate  = static fn ($d) => (bool) preg_match('/^\d{4}-\d{2}-\d{2}$/', $d);
        $from    = $isDate($from) ? $from : '';
        $to      = $isDate($to) ? $to : '';
        $perPage = 50;
        $page    = max(1, (int) $this->request->getGet('page'));

        $rows = (new SalaryModel())->payroll_audit_list(
            $session->get('emp_id'), $module, $emp, $from, $to, mb_substr($search, 0, 100), $perPage, ($page - 1) * $perPage
        );
        $error = null;
        if (!empty($rows) && strtoupper((string) ($rows[0]['status'] ?? '')) !== 'Y') {
            $error = $rows[0]['remarks'] ?? 'The audit log could not be loaded.';
            $rows  = [];
        }

        return view('Layouts/Header')
            . view('Layouts/Sidebar')
            . view('payroll/audit_log', [
                'rows'    => $rows,
                'error'   => $error,
                'modules' => $modules,
                'filters' => ['module' => $module, 'emp' => $emp, 'from' => $from, 'to' => $to, 'q' => $search],
                'page'    => $page,
                'perPage' => $perPage,
                'total'   => (int) ($rows[0]['total_rows'] ?? 0),
            ])
            . view('Layouts/Footer');
    }

