    # Current salaries with ESI off although GROSS is within the ESI wage limit, keyed by emp_id
    public function esi_review($id)
    {
        $rows = $this->callProcedureRows('hrms_salary_esi_review', [$id]);
        $out = [];
        foreach ($rows as $r) {
            if (($r['status'] ?? '') === 'Y' && !empty($r['emp_id'])) {
                $out[$r['emp_id']] = $r;
            }
        }
        return $out;
    }

