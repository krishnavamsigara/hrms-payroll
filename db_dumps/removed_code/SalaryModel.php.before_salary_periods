    // Common Procedure Caller

    protected function callProcedure(
        string $procedureName,
        array $params = [],
        bool $isQuery = true
    ) {
        try {
            if (!empty($params)) {
                $escapedParams = array_map(function ($param) {
                    return "'" . $this->db->escapeString((string)$param) . "'";
                }, $params);
                $sql = "CALL {$procedureName}(" . implode(',', $escapedParams) . ")";
                $query = $this->db->query($sql);
            } else {
                $sql = "CALL {$procedureName}()";
                $query = $this->db->query($sql);
            }

            if ($isQuery && $query) {
                $result = $query->getResultArray();

                if ($this->db->connID instanceof \mysqli) {
                    try {
                        while (@mysqli_more_results($this->db->connID) && @mysqli_next_result($this->db->connID)) {
                            // Drain extra result sets left by MySQL stored procedure CALL
                        }
                    } catch (\Throwable $ex) {
                        // Suppress PHP 8.1+ strict mysqli exception
                    }
                }

                $this->auditDenied($procedureName, $result);
                return $result;
            }

            return $query ? ($this->db->affectedRows() > 0) : false;
        } catch (\Throwable $e) {
            log_message('error', 'callProcedure Error [' . $procedureName . ']: ' . $e->getMessage());
            return $isQuery ? [] : false;
        }
    }

    /**
     * Procedure caller for the component / slab engine procedures.
     * Unlike callProcedure(), a PHP null or '' is sent as SQL NULL (so numeric
     * parameters work in strict SQL mode) and a database error is returned as
     * a row ['status' => 'N', 'remarks' => message] instead of being hidden.
     */
    protected function callProcedureRows(string $procedureName, array $params = []): array
    {
        try {
            $parts = array_map(function ($param) {
                if ($param === null || $param === '') {
                    return 'NULL';
                }
                return "'" . $this->db->escapeString((string) $param) . "'";
            }, $params);

            $query  = $this->db->query("CALL {$procedureName}(" . implode(',', $parts) . ")");
            $result = $query ? $query->getResultArray() : [];

            if ($this->db->connID instanceof \mysqli) {
                try {
                    while (@mysqli_more_results($this->db->connID) && @mysqli_next_result($this->db->connID)) {
                        // Drain extra result sets left by the stored procedure CALL
                    }
                } catch (\Throwable $ex) {
                    // Nothing more to read
                }
            }

            $this->auditDenied($procedureName, $result);
            return $result;
        } catch (\Throwable $e) {
            log_message('error', 'callProcedureRows Error [' . $procedureName . ']: ' . $e->getMessage());
            return [['status' => 'N', 'remarks' => 'Database error: ' . $e->getMessage()]];
        }
    }

    /**
     * Payroll audit trail (C-129): when a payroll procedure answers "Access denied",
     * record who tried it. Never breaks the page if the audit write fails.
     */
    protected function auditDenied(string $procedureName, array $rows): void
    {
        $first = $rows[0] ?? null;
        if (!is_array($first) || strtoupper((string) ($first['status'] ?? '')) !== 'N') {
            return;
        }
        $message = (string) ($first['remarks'] ?? $first['message'] ?? '');
        if (stripos($message, 'Access denied') !== 0) {
            return;
        }
        $this->auditEventCall('ACCESS_DENIED', $procedureName, null, null, null, $message);
    }

    /** Calls hrms_payroll_audit_event and drains its result sets; returns its first row. */
    protected function auditEventCall(string $action, ?string $refId, ?string $affected, $month, $year, ?string $remarks, ?string $by = null): array
    {
        try {
            $by ??= (string) (session()->get('emp_id') ?? '');
            $query = $this->db->query('CALL hrms_payroll_audit_event(?, ?, ?, ?, ?, ?, ?)', [
                $by, $action, $refId, $affected,
                $month === null || $month === '' ? null : (int) $month,
                $year === null || $year === '' ? null : (int) $year,
                $remarks === null ? null : mb_substr($remarks, 0, 1000),
            ]);
            $row = $query ? ($query->getRowArray() ?? []) : [];
            if ($this->db->connID instanceof \mysqli) {
                try {
                    while (@mysqli_more_results($this->db->connID) && @mysqli_next_result($this->db->connID)) {
                    }
                } catch (\Throwable $ex) {
                }
            }
            return $row;
        } catch (\Throwable $e) {
            log_message('error', 'payroll audit event [' . $action . ']: ' . $e->getMessage());
            return ['status' => 'N', 'remarks' => 'The event could not be recorded.'];
        }
    }

    # For other models (attendance procedures in AdminModel): record an "Access denied" answer.
    public function payroll_audit_denied(string $procedureName, array $rows): void
    {
        $this->auditDenied($procedureName, $rows);
    }

    # Payroll audit log page (C-130): active ADMIN or HR only, newest first.
    public function payroll_audit_list($emp_id, $module, $emp, $from, $to, $search, $limit, $offset)
