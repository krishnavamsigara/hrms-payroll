    # Record that a payslip PDF was downloaded (C-129).
    public function payroll_audit_payslip_download($emp_id, $ref_id, $affected_emp_id, $month, $year, $remarks)
    {
        $row = $this->auditEventCall('PAYSLIP_DOWNLOAD', $ref_id, $affected_emp_id, $month, $year, $remarks, $emp_id);
        $this->auditDenied('payslip download ' . $affected_emp_id, [$row]);   // someone else's payslip
        return $row;
    }

