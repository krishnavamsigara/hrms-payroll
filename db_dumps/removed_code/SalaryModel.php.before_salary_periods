    # Salary Components adding new component, Editing existing component, managing existing component
    public function manage_salary_components(
        $emp_id,
        $action,
        $component_id,
        $code,
        $name,
        $type,
        $calculation_type,
        $percentage_base,
        $percentage,
        $taxable ,
        $active,
        $formula_expression = null,
        $minimum_amount = null,
        $maximum_amount = null,
        $calculation_scope = null,
        $calculation_order = null,
        $eligibility_parameter = null,
        $eligibility_required_value = null,
        $is_slab = null,
        $rounding_precision = null,
        $is_manual = null,
        $slab_json = null,   // null = leave slabs as they are; JSON array string = replace them
        $dry_run = 0,        // 1 = check only, nothing is saved
        $add_to_total = 0    // 1 = put the component into the total of its type
        )
    {
        return $this->callProcedureRows('hrms_update_component_master', [
            $emp_id, $action, $component_id, $code, $name, $type, $calculation_type, $percentage_base, $percentage, $taxable, $active,
            $formula_expression, $minimum_amount, $maximum_amount, $calculation_scope, $calculation_order,
            $eligibility_parameter, $eligibility_required_value, $is_slab, $rounding_precision,
            $is_manual, $slab_json, $dry_run ? 1 : 0, $add_to_total ? 1 : 0,
        ]);
    }

